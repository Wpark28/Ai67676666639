{
  "manifest_version": 3,
  "name": "Classroom Auto-Completer",
  "version": "1.0.0",
  "description": "Assists with Google Classroom assignments with adjustable grade level, grammar, and complexity settings.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://classroom.google.com/*", "https://docs.google.com/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://classroom.google.com/*", "https://docs.google.com/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"]
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
